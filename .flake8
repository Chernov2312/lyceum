[flake8]
exclude = 
    .git
    __pycache__
    .tox
    .eggs
    *.egg
    .venv
    venv
    */site-packages/*
    ./*/site-packages/*
    ./.venv/*
    ./*/migrations

max-line-length = 79
import-order-style = google
application-import-names = about, catalog, core, homepage, lyceum, download, feedback